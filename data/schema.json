{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NFP AI Use-Case Tracker database",
  "type": "object",
  "required": [
    "meta",
    "cases"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "name",
        "last_updated"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "last_updated": {
          "type": "string",
          "format": "date"
        },
        "schema": {
          "type": "string"
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "title": "Case",
      "description": "One case. id = organisation slug + '--' + category slug, e.g. 'justice-connect--intake'. One id per organisation and use case, so the same use is never listed twice.",
      "type": "object",
      "required": [
        "id",
        "status",
        "organisation",
        "category",
        "use_case",
        "stage",
        "quote",
        "sources",
        "first_seen",
        "last_seen"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*--[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "organisation": {
          "type": "string",
          "description": "The NFP's name as written in the source"
        },
        "org_type": {
          "type": "string",
          "enum": [
            "Charity",
            "Community legal centre",
            "Community legal organisation",
            "NFP",
            "NFP research institute",
            "Unclear"
          ],
          "description": "'Unclear' when it may be a company rather than an NFP"
        },
        "state": {
          "type": "string",
          "enum": [
            "NSW",
            "VIC",
            "QLD",
            "WA",
            "SA",
            "TAS",
            "ACT",
            "NT",
            "National",
            ""
          ]
        },
        "cause_area": {
          "type": "string",
          "description": "Short label, e.g. 'homelessness, youth'"
        },
        "category": {
          "type": "string",
          "enum": [
            "client-facing chatbot or assistant",
            "intake, triage or referral",
            "service delivery or decision support",
            "fundraising, marketing or communications",
            "grant writing or reporting",
            "data analysis, research or evaluation",
            "internal operations or productivity",
            "advocacy, policy or legal",
            "other"
          ]
        },
        "use_case": {
          "type": "string",
          "description": "One plain sentence: what the AI does and for whom"
        },
        "partner": {
          "type": "string",
          "description": "Vendor, tool or funder, or empty"
        },
        "stage": {
          "type": "string",
          "enum": [
            "deployed",
            "pilot",
            "funded",
            "announced",
            "unclear",
            "discontinued"
          ]
        },
        "quote": {
          "type": "string",
          "description": "Short sentence copied verbatim from a source page (the evidence)"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string"
              },
              "title": {
                "type": "string",
                "description": "Publisher (date)"
              }
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "tracker",
            "review"
          ],
          "description": "tracker = verified (shown under 'Verified'); review = not yet verified"
        },
        "review_reason": {
          "type": "string",
          "description": "Why a person needs to check it; empty for tracker rows"
        },
        "first_seen": {
          "type": "string",
          "format": "date"
        },
        "last_seen": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": false
    }
  }
}